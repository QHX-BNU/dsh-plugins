{
  "name": "dsh-tool-manager",
  "version": "0.1.0",
  "description": "工具管理：显示 DSH 全部已注册工具（名称/描述/参数/状态），制作自定义工具（定义参数与执行代码，保存后立即注册为主 Agent 可用工具），支持禁用/启用/删除任意工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "tool",
    "tool-manager",
    "工具管理",
    "自定义工具"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "^1.0.0",
    "@deepseek-ai/dsh-home-paths": "^1.0.0"
  }
}
