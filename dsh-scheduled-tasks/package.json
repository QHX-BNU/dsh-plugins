{
  "name": "dsh-scheduled-tasks",
  "version": "0.1.0",
  "description": "DSH 定时任务插件：设置任务执行时间与内容，到点自动向会话发送消息唤醒 Agent 或执行系统命令",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "schedule",
    "cron",
    "task",
    "定时任务"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
